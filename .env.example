# Server
PORT=?
NODE_ENV=development

# Database (Supabase)
# DATABASE_URL: pooler, transaction 모드 (포트 6543) — 앱 런타임 쿼리용. 예:
#   postgresql://...@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=10
# connection_limit은 홈 화면 등에서 동시에 나가는 API 요청 수 이상으로 잡아야 함
# (너무 낮으면 Prisma pool_timeout(기본 10초) 초과로 요청이 500으로 끊김)
DATABASE_URL=
# DIRECT_URL: 직접 연결 (포트 5432, 풀러 미경유) — `prisma migrate` 전용. 예:
#   postgresql://...@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
DIRECT_URL=

# JWT
JWT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET= (프론트에서 처리하므로 백엔드에선 필수는 아님)
